# Copie este arquivo para .env e preencha com os seus valores.
# Nunca versione credenciais reais (.env* está no .gitignore).

# --- Desenvolvimento (PostgreSQL local descartável) ---
# DATABASE_URL="postgresql://pelada_dev:pelada_dev@localhost:5432/pelada_dev"
# DIRECT_URL=""

# --- Produção (Neon + Vercel) ---
# No Neon Console → Connect, copie as DUAS URLs (nunca cole senhas neste arquivo versionado):
#
# DATABASE_URL  = connection string COM pooling ("-pooler" no hostname).
#                 Usada em runtime pela app (Vercel / Prisma Client + @prisma/adapter-pg).
#                 Exemplo de forma (placeholders):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
#
# DIRECT_URL    = connection string DIRETA (sem "-pooler").
#                 Usada só pelo Prisma CLI: migrate deploy / migrate status / bootstrap.
#                 Exemplo de forma (placeholders):
# DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"
#
# Em desenvolvimento local sem Neon, deixe DIRECT_URL vazio: o CLI usa DATABASE_URL.

DATABASE_URL="postgresql://pelada_dev:pelada_dev@localhost:5432/pelada_dev"
DIRECT_URL=""

# Segredo do /api/cron/tick (cria sessões semanais e aplica prazos da lista).
# Gere um valor aleatório longo (ex.: openssl rand -hex 32).
# Sem ele a rota responde 401; as páginas continuam sincronizando sob demanda.
# Obrigatório em produção se você configurar o Vercel Cron (veja docs/deploy-vercel-neon.md).
# CRON_SECRET=""

# Web Push (ainda não usado; nomes reservados, veja docs/architecture.md).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@example.com"
