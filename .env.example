# Copie este arquivo para .env e preencha com os seus valores.
# Nunca versione credenciais reais.

# Conexão PostgreSQL usada pela aplicação em runtime e por `npm run bootstrap`.
# Desenvolvimento: um banco local descartável (veja README.md).
# Em produção (Vercel), pode ser a URL com pooling do provedor.
DATABASE_URL="postgresql://pelada_dev:pelada_dev@localhost:5432/pelada_dev"

# Conexão direta usada pelo Prisma CLI (migrations).
# Opcional em desenvolvimento local: se vazia, o CLI usa DATABASE_URL.
DIRECT_URL=""

# Segredo do /api/cron/tick (cria sessões semanais e aplica prazos da lista).
# Sem ele a rota responde 401; as páginas continuam fazendo isso sob demanda.
# CRON_SECRET=""

# Web Push (ainda não usado; nomes reservados, veja docs/architecture.md).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@example.com"
