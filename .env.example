# Copie este arquivo para .env e preencha com os seus valores.
# Nunca versione credenciais reais.

# Conexão PostgreSQL usada pela aplicação em runtime.
# Em produção (Vercel), pode ser a URL com pooling do provedor.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/pelada?schema=public"

# Conexão direta usada pelo Prisma CLI (migrations).
# Opcional em desenvolvimento local: se vazia, o CLI usa DATABASE_URL.
DIRECT_URL=""
