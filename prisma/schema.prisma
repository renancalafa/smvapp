  BIRTHDAY_DRAFT
}

enum GameSessionOrigin {
  AUTOMATIC
  EXTRAORDINARY
}

enum OverflowMode {
  FIXED_TEAMS
  FLEXIBLE_ROTATION
}

enum RegistrationStatus {
  PARTICIPANT
  WAITLISTED
  DECLINED
  WITHDRAWN
  REMOVED
}

enum PriorityTier {
  MONTHLY_PRIORITY
  GENERAL
}

enum ActionSource {
  SELF
  ADMIN
  SYSTEM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum BirthdayDraftStatus {
  BUILDING
  FINALIZED
  CANCELLED
}

enum DrawStatus {
  VOTING
  DECIDED
  TIED
  INVALIDATED
}

enum DrawDecisionMethod {
  VOTE
  SINGLE_OPTION
  ADMIN_RESOLUTION
}

/// Usado por DrawTeam e SessionTeam.
enum TeamKind {
  REGULAR
  BIRTHDAY
  ROTATION_POOL
}

enum SessionTeamOrigin {
  DRAW
  BIRTHDAY_DRAFT
  MANUAL
}

enum MatchStatus {
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum MatchPlayerRole {
  FIELD
  GOALKEEPER
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  BIG_MISS
  YELLOW_CARD
  BLUE_CARD
  RED_CARD
  /// Bola na trave.
  HIT_WOODWORK
  /// Desarme.
  TACKLE
}

/// Papel preferido em campo (A/D/V). Opcional; não inventar no seed.
enum PreferredRole {
  ATTACKER
  DEFENDER
  VERSATILE
}

/// Atributo de nota sujeito a proposta comunitária (um por proposta).
enum RatingAttribute {
  OVERALL
  ATTACK
  DEFENSE
  PHYSICAL
}

enum RatingProposalStatus {
  PENDING_ADMIN_REVIEW
  REJECTED_INITIAL
  OPEN_FOR_VOTING
  VOTING_CLOSED
  APPLIED
  REJECTED_FINAL
  SUPERSEDED_STALE
}

enum RatingVoteChoice {
  FOR
  AGAINST
}

/// Origem de uma linha em MemberRatingHistory.
enum MemberRatingChangeSource {
  ADMIN_DIRECT
  ADMIN_INITIAL_ASSIGN
  PROPOSAL_APPLIED
}

/// OPEN: acumula receitas de diaristas; a mensalidade é previsão.
/// CLOSED: mensalidade congelada. O ciclo continua recebendo pagamentos de mensalidade e
/// o pagamento do campo; só os valores do cálculo ficam imutáveis.
enum BillingCycleStatus {
  OPEN
  CLOSED
}

/// REGULAR: mensalidade calculada pelo sistema no congelamento.
/// OPENING: mês corrente na implantação; mensalidade declarada pelo ADMIN, sem cálculo.
enum BillingCycleKind {
  REGULAR
  OPENING
}

enum ChargeType {
  DAILY_FEE
  MONTHLY_FEE
}

/// Origem de uma Charge MONTHLY_FEE.
/// CYCLE_FREEZE: criada no congelamento, uma por pagante do divisor.
/// LATE_JOIN: novo mensalista, que só entra do dia 1 ao 7 (depois do congelamento); paga
/// o valor congelado sem alterar divisor, total cobrado, arredondamento ou crédito.
/// OPENING: criada na implantação para quem ainda devia a mensalidade do mês corrente.
enum MonthlyFeeOrigin {
  CYCLE_FREEZE
  LATE_JOIN
  OPENING
}

enum ChargeStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  CONFIRMED
  REVERSED
}

/// Comprovante enviado pelo jogador; aprovação Admin cria Payment.
enum PaymentReceiptStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

/// Liberação excepcional de acesso apesar de dívida em aberto.
enum FinancialAccessGrantKind {
  MONTHLY
  DAILY
}

/// Apenas o rótulo da forma de pagamento; não há integração.
enum PaymentMethod {
  CASH
  PIX
  BANK_TRANSFER
  OTHER
}

enum CashDirection {
  IN
  OUT
}

enum CashCategory {
  DAILY_FEE
  MONTHLY_FEE
  FIELD_COST
  INITIAL_BALANCE
  OTHER_EXPENSE
  ADJUSTMENT
}

enum BillingCreditAllocationStatus {
  APPROVED
  APPLIED
  SUPERSEDED
  VOIDED
}

enum NotificationType {
  LIST_OPENED
  MONTHLY_DECLINED
  WAITLIST_PROMOTED
  DAILY_PLAYERS_NEEDED
  SESSION_CANCELLED
  PRIORITY_REMINDER
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  EXPIRED
}

enum ActorType {
  USER
  SYSTEM
}

// ============================================================================
// Identidade, autenticação e grupo
// ============================================================================

/// Identidade global e credencial de login. Role, modalidade e nota pertencem ao GroupMember.
/// Contas são criadas somente por ADMIN, com senha temporária individual e aleatória.
/// CHECK (SQL): username = lower(username) e não vazio.
model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// Armazenado normalizado (minúsculas).
  username           String    @unique
  name               String
  /// Contato opcional (minúsculas). Não é usado no login; null em contas antigas.
  email              String?   @unique
  birthDate          DateTime? @db.Date
  /// Hash da senha (string PHC; hoje scrypt do node:crypto). A senha em texto puro nunca é
  /// persistida.
  passwordHash       String
  /// true após criação ou redefinição pelo ADMIN; bloqueia o uso até a troca da senha.
  mustChangePassword Boolean   @default(true)
  disabledAt         DateTime? @db.Timestamptz(3)
  createdByUserId    String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  createdBy    User?  @relation("UserCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdUsers User[] @relation("UserCreatedBy")

  authSessions            AuthSession[]
  memberships             GroupMember[]
  pushSubscriptions       PushSubscription[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  idempotentOperations    IdempotentOperation[]
  groupSettingsUpdated    GroupSettings[]
  feeExemptionsUpdated    GroupMember[]          @relation("FeeExemptUpdatedBy")
  sessionsCreated         GameSession[]          @relation("GameSessionCreatedBy")
  sessionsCancelled       GameSession[]          @relation("GameSessionCancelledBy")
  overflowDecisions       GameSession[]          @relation("GameSessionOverflowDecidedBy")
  manualOverrides         SessionRegistration[]  @relation("RegistrationManualOverrideBy")
  rotatingAssignments     SessionRegistration[]  @relation("RegistrationRotatingSetBy")
  attendanceMarks         SessionRegistration[]  @relation("RegistrationAttendanceMarkedBy")
  unavailabilitiesStarted PlayerUnavailability[] @relation("UnavailabilityStartedBy")
  unavailabilitiesEnded   PlayerUnavailability[] @relation("UnavailabilityEndedBy")
  drawsCreated            Draw[]                 @relation("DrawCreatedBy")
  drawsDecided            Draw[]                 @relation("DrawDecidedBy")
  drawsInvalidated        Draw[]                 @relation("DrawInvalidatedBy")
  matchEventsCreated      MatchEvent[]           @relation("MatchEventCreatedBy")
  matchEventsVoided       MatchEvent[]           @relation("MatchEventVoidedBy")
  matchSubstitutions      MatchSubstitution[]    @relation("MatchSubstitutionCreatedBy")
  billingCyclesClosed     BillingCycle[]
  chargesCreated          Charge[]               @relation("ChargeCreatedBy")
  chargesCancelled        Charge[]               @relation("ChargeCancelledBy")
  paymentsConfirmed       Payment[]              @relation("PaymentConfirmedBy")
  paymentsReversed        Payment[]              @relation("PaymentReversedBy")
  cashTransactions        CashTransaction[]
  billingCreditApprovals  BillingCreditAllocation[] @relation("BillingCreditApprovedBy")
  paymentReceiptsUploaded PaymentReceipt[]       @relation("PaymentReceiptUploadedBy")
  paymentReceiptsReviewed PaymentReceipt[]       @relation("PaymentReceiptReviewedBy")
  financialAccessGranted  FinancialAccessGrant[] @relation("FinancialAccessGrantedBy")
  financialAccessRevoked  FinancialAccessGrant[] @relation("FinancialAccessRevokedBy")
  sessionScouts           SessionScout[]         @relation("SessionScoutUser")
  sessionScoutsAssigned   SessionScout[]         @relation("SessionScoutAssignedBy")
  sessionScoutsRevoked    SessionScout[]         @relation("SessionScoutRevokedBy")
  ratingProposalsInitialReviewed RatingChangeProposal[] @relation("RatingProposalInitialReviewedBy")
  ratingProposalsVotingClosed    RatingChangeProposal[] @relation("RatingProposalVotingClosedBy")
  ratingProposalsFinalDecided    RatingChangeProposal[] @relation("RatingProposalFinalDecidedBy")
  memberRatingHistoryActed       MemberRatingHistory[]  @relation("MemberRatingHistoryActor")
}

/// Sessão de login própria, referenciada por cookie HttpOnly (Secure em produção).
/// O cookie carrega um token aleatório; o banco guarda só o hash dele.
/// Sessão válida: revokedAt nulo, expiresAt no futuro e User sem disabledAt.
/// A redefinição de senha pelo ADMIN revoga todas as sessões ativas do usuário.
model AuthSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  /// Hash (ex.: SHA-256) do token do cookie. O token bruto nunca é persistido.
  tokenHash  String    @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  userAgent  String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// Rate limit de login compartilhado entre instâncias serverless (sem Redis).
/// key: "ip:<hash>" ou "user:<username>"; failureCount na janela windowStartedAt.
model LoginThrottle {
  key             String    @id
  failureCount    Int       @default(0)
  windowStartedAt DateTime  @db.Timestamptz(3)
  blockedUntil    DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([blockedUntil])
}

/// A pelada. Hoje existe uma única linha (seed); é a âncora do futuro SaaS.
model Group {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  /// IANA, por exemplo America/Sao_Paulo.
  timezone  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  settings             GroupSettings?
  members              GroupMember[]
  seasons              Season[]
  gameSessions         GameSession[]
  billingCycles             BillingCycle[]
  charges                   Charge[]
  cashTransactions          CashTransaction[]
  billingCreditAllocations  BillingCreditAllocation[]
  paymentReceipts           PaymentReceipt[]
  financialAccessGrants     FinancialAccessGrant[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  idempotentOperations      IdempotentOperation[]
  ratingChangeProposals     RatingChangeProposal[]
  memberRatingHistory       MemberRatingHistory[]
}

/// Valores padrão usados para gerar novas sessões e ciclos. Sem @default de negócio:
/// os valores vêm do seed ou do ADMIN. Toda alteração gera AuditLog com before/after.
/// CHECK (SQL): minutos do dia entre 0 e 1439 (inclui reminder); maxExtraMinutes entre 0 e 30;
/// dias >= 0 (inclui reminder); contagens e duração > 0; dailyFeeCents > 0;
/// monthlyFieldCostCents >= 0; fieldPaymentDueDay e monthlyFeeDueDay entre 1 e 31.
model GroupSettings {
  groupId String @id @db.Uuid

  // Agenda (horários em minuto do dia, fuso do Group)
  sessionWeekday              Weekday
  sessionStartMinute          Int
  sessionEndMinute            Int
  /// Tempo extra máximo além de sessionEndMinute, em minutos (0 a 30; seed: 30).
  /// É uma duração, não um minuto do dia.
  maxExtraMinutes             Int
  /// Dias antes da sessão em que a lista abre (ex.: 3 = segunda para quinta).
  registrationOpensDaysBefore Int
  registrationOpensMinute     Int
  /// Dias antes da sessão em que termina a prioridade dos mensalistas (ex.: 0 = no dia).
  priorityDeadlineDaysBefore  Int
  priorityDeadlineMinute      Int
  /// Dias antes da sessão do lembrete do prazo dos mensalistas (ex.: 0 = no dia).
  priorityReminderDaysBefore  Int
  priorityReminderMinute      Int
  /// Se false, o lembrete não é agendado (valores de dia/hora ficam guardados).
  priorityReminderEnabled     Boolean
  /// Antecedência, em dias, da criação automática em relação à abertura da lista (seed: 7).
  sessionAutoCreateLeadDays   Int

  // Formato
  maxPlayers              Int
  teamSize                Int
  matchDurationSec        Int
  drawOptionsCount        Int
  drawMinOptionDifference Int

  // Financeiro
  /// Sempre > 0: não existe diarista gratuito no MVP.
  dailyFeeCents         Int
  monthlyFieldCostCents Int
  /// Prazo do pagamento do campo, no próprio mês do ciclo (seed: 10).
  /// Se o mês não tiver o dia, vale o último dia do mês.
  fieldPaymentDueDay    Int
  /// Prazo de pagamento da mensalidade, no próprio mês do ciclo (seed: 7). A mensalidade
  /// é congelada e fica pagável no dia 1 (fixo). Mês sem o dia: último dia do mês.
  monthlyFeeDueDay      Int
  /// ISO 4217, por exemplo BRL.
  currency              String
  /// Chave PIX exibida ao pagador (opcional). Alterações não afetam ciclos já congelados.
  pixKey                String?
  /// CPF | CNPJ | EMAIL | PHONE | RANDOM (texto livre validado no service).
  pixKeyType            String?
  /// Nome do beneficiário PIX exibido ao pagador.
  pixBeneficiaryName    String?
  /// Quando false (padrão), dívidas NÃO restringem navegação — seguro até ativação explícita.
  financeAccessLocksEnabled Boolean @default(false)

  /// Fase 1 ratings: votação comunitária de notas. Padrão OFF — não ativar sem aprovação.
  ratingVotingEnabled Boolean @default(false)
  /// Fase 1 ratings: balanceamento multi-atributo. Padrão OFF — não ativa balance-v3.
  /// Quando true E o elenco alocado tem Overall/Ataque/Defesa/Físico completos, o sorteio usa balance-v3.
  /// Default false — não ativa em produção. Atributos incompletos → fallback explícito para balance-v2.
  advancedDrawBalancingEnabled Boolean @default(false)

  // Local
  venueName    String?
  venueAddress String?

  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  updatedByUserId String?  @db.Uuid

  group     Group @relation(fields: [groupId], references: [id])
  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)
}

/// O jogador dentro de uma pelada. Referências de domínio apontam para cá, nunca para User.
/// CHECK (SQL): baseRating entre 1 e 5; attack/defense/physical NULL ou 1–5.
model GroupMember {
  id                       String         @id @default(uuid(7)) @db.Uuid
  groupId                  String         @db.Uuid
  userId                   String         @db.Uuid
  role                     MemberRole
  modality                 PlayerModality
  /// Overall Skill (1–5). Histórico: visível só a ADMIN; votação comunitária altera a política na Fase 2+.
  baseRating               Int
  /// Atributos opcionais — não popular automaticamente.
  attackRating             Int?
  defenseRating            Int?
  physicalRating           Int?
  preferredRole            PreferredRole?
  nickname                 String?
  status                   MemberStatus   @default(ACTIVE)
  feeExempt                Boolean        @default(false)
  feeExemptReason          String?
  feeExemptUpdatedAt       DateTime?      @db.Timestamptz(3)
  feeExemptUpdatedByUserId String?        @db.Uuid
  createdAt                DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(3)

  group              Group @relation(fields: [groupId], references: [id])
  user               User  @relation(fields: [userId], references: [id])
  feeExemptUpdatedBy User? @relation("FeeExemptUpdatedBy", fields: [feeExemptUpdatedByUserId], references: [id], onDelete: Restrict)

  registrations             SessionRegistration[]
  birthdayDraftCelebrations BirthdayDraftCelebrant[]
  birthdayDraftPicks        BirthdayDraftPick[]
  drawTeamSlots             DrawTeamPlayer[]
  drawVotes                 DrawVote[]
  sessionTeamSlots          SessionTeamPlayer[]
  matchAppearances          MatchPlayer[]
  matchEventsAuthored       MatchEvent[]             @relation("MatchEventAuthor")
  matchEventsAssisted       MatchEvent[]             @relation("MatchEventAssist")
  matchSubstitutionsOut     MatchSubstitution[]      @relation("MatchSubstitutionOut")
  matchSubstitutionsIn      MatchSubstitution[]      @relation("MatchSubstitutionIn")
  charges                   Charge[]
  payments                  Payment[]
  paymentReceipts           PaymentReceipt[]
  financialAccessGrants     FinancialAccessGrant[]
  ratingProposalsTargeted   RatingChangeProposal[]   @relation("RatingProposalTarget")
  ratingProposalsProposed   RatingChangeProposal[]   @relation("RatingProposalProposer")
  ratingChangeVotes         RatingChangeVote[]
  ratingHistory             MemberRatingHistory[]

  @@unique([groupId, userId])
  @@index([groupId, status, modality])
}

// ============================================================================
// Temporada e sessão
// ============================================================================

/// CHECK (SQL): endsOn >= startsOn.
model Season {
  id        String   @id @default(uuid(7)) @db.Uuid
  groupId   String   @db.Uuid
  name      String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  group        Group         @relation(fields: [groupId], references: [id])
  gameSessions GameSession[]

  @@unique([groupId, name])
}

/// Uma ocorrência da pelada, com snapshot da configuração no momento da criação.
/// CHECK (SQL): endsAt > startsAt; status CANCELLED exige cancelledAt e cancelReason não
/// vazio.
/// Não tem ciclo financeiro: a receita de diária é atribuída ao ciclo pela confirmação
/// do pagamento (ver CashTransaction), não pela data da sessão.
/// Invariantes (service):
/// - season.groupId = groupId;
/// - scheduledFor dentro de [season.startsOn, season.endsOn].
model GameSession {
  id           String            @id @default(uuid(7)) @db.Uuid
  groupId      String            @db.Uuid
  seasonId     String            @db.Uuid
  status       GameSessionStatus @default(SCHEDULED)
  type         GameSessionType   @default(NORMAL)
  origin       GameSessionOrigin
  /// Data civil da sessão no fuso do Group.
  scheduledFor DateTime          @db.Date

  // Snapshot da configuração
  startsAt                DateTime @db.Timestamptz(3)
  endsAt                  DateTime @db.Timestamptz(3)
  maxExtraMinutes         Int
  registrationOpensAt     DateTime  @db.Timestamptz(3)
  priorityDeadlineAt      DateTime  @db.Timestamptz(3)
  /// Snapshot do lembrete do prazo (nulo = desligado na criação). AUTOMATIC only.
  priorityReminderAt      DateTime? @db.Timestamptz(3)
  maxPlayers              Int
  teamSize                Int
  matchDurationSec        Int
  drawOptionsCount        Int
  drawMinOptionDifference Int
  dailyFeeCents           Int
  venueName               String?

  // 16 a 19 participantes após o deadline
  overflowMode            OverflowMode?
  overflowDecidedAt       DateTime?     @db.Timestamptz(3)
  overflowDecidedByUserId String?       @db.Uuid

  // Marcadores idempotentes dos jobs e transições
  openedAt           DateTime? @db.Timestamptz(3)
  priorityClosedAt   DateTime? @db.Timestamptz(3)
  startedAt          DateTime? @db.Timestamptz(3)
  finishedAt         DateTime? @db.Timestamptz(3)
  chargesGeneratedAt DateTime? @db.Timestamptz(3)

  // Cancelamento
  cancelledAt       DateTime? @db.Timestamptz(3)
  cancelledByUserId String?   @db.Uuid
  cancelReason      String?

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  group             Group  @relation(fields: [groupId], references: [id])
  season            Season @relation(fields: [seasonId], references: [id])
  overflowDecidedBy User?  @relation("GameSessionOverflowDecidedBy", fields: [overflowDecidedByUserId], references: [id], onDelete: Restrict)
  cancelledBy       User?  @relation("GameSessionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  createdBy         User?  @relation("GameSessionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  registrations    SessionRegistration[]
  birthdayDraft    BirthdayDraft?
  draws            Draw[]
  teams            SessionTeam[]
  matches          Match[]
  sessionScouts    SessionScout[]
  charges          Charge[]
  cashTransactions CashTransaction[]
  auditLogs        AuditLog[]

  /// PARCIAL: impede o job de recriar uma sessão automática, inclusive se cancelada.
  /// Consultar com { groupId, scheduledFor, origin: "AUTOMATIC" }.
  @@unique([groupId, scheduledFor], map: "GameSession_automatic_slot_key", where: { origin: "AUTOMATIC" })
  @@index([groupId, startsAt])
  @@index([groupId, priorityReminderAt])
  @@index([status])
}

/// Scout temporário da sessão (não é papel global). Histórico de revoke preservado.
/// PARCIAL: no máximo uma atribuição ativa (revokedAt IS NULL) por (sessão, usuário).
model SessionScout {
  id               String    @id @default(uuid(7)) @db.Uuid
  gameSessionId    String    @db.Uuid
  userId           String    @db.Uuid
  assignedByUserId String    @db.Uuid
  assignedAt       DateTime  @default(now()) @db.Timestamptz(3)
  revokedByUserId  String?   @db.Uuid
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  user        User        @relation("SessionScoutUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy  User        @relation("SessionScoutAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  revokedBy   User?       @relation("SessionScoutRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@unique([gameSessionId, userId], map: "SessionScout_active_per_session_user_key", where: { revokedAt: null })
  @@index([userId, revokedAt])
  @@index([gameSessionId, revokedAt])
}

// ============================================================================
// Presença
// ============================================================================

/// Uma linha por membro por sessão. O status é a alocação materializada.
/// CHECK (SQL): status PARTICIPANT ou WAITLISTED exige queuedAt, queueSortAt e priorityTier;
/// manualOverrideAt exige manualOverrideReason não vazio.
/// Invariantes (service):
/// - member.groupId = gameSession.groupId;
/// - a quantidade de PARTICIPANT nunca excede a capacidade efetiva da sessão, inclusive
///   em intervenção administrativa (lock da linha da GameSession na transação);
/// - attendance só é marcada em inscrição PARTICIPANT;
/// - mudanças de status antes da primeira Match nunca invalidam o Draw automaticamente;
///   só o ADMIN decide refazer o sorteio (ver Draw);
/// - depois que a sessão tem alguma Match, o conjunto de PARTICIPANT fica congelado:
///   nenhuma mudança de status (inclusão, remoção, cancelamento, promoção da fila,
///   redução de capacidade). Os comandos de presença travam a mesma linha da GameSession
///   que a criação da Match. attendance continua podendo ser marcada e corrigida.
model SessionRegistration {
  id               String             @id @default(uuid(7)) @db.Uuid
  gameSessionId    String             @db.Uuid
  memberId         String             @db.Uuid
  status           RegistrationStatus
  /// Instante original da confirmação; nunca alterado por intervenção. Nulo em DECLINED.
  queuedAt         DateTime?          @db.Timestamptz(3)
  /// Posição efetiva na fila; igual a queuedAt salvo intervenção administrativa.
  queueSortAt      DateTime?          @db.Timestamptz(3)
  priorityTier     PriorityTier?
  modalitySnapshot PlayerModality
  source           ActionSource
  respondedAt      DateTime           @db.Timestamptz(3)
  promotedAt       DateTime?          @db.Timestamptz(3)
  withdrawnAt      DateTime?          @db.Timestamptz(3)

  // Última intervenção administrativa (histórico completo no AuditLog)
  manualOverrideAt       DateTime? @db.Timestamptz(3)
  manualOverrideByUserId String?   @db.Uuid
  manualOverrideReason   String?

  // Rotativos (FLEXIBLE_ROTATION)
  isRotating          Boolean   @default(false)
  rotatingSetByUserId String?   @db.Uuid
  rotatingSetAt       DateTime? @db.Timestamptz(3)

  // Presença real (Modo Pelada); nulo = não marcada
  attendance               AttendanceStatus?
  attendanceMarkedAt       DateTime?         @db.Timestamptz(3)
  attendanceMarkedByUserId String?           @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  gameSession        GameSession @relation(fields: [gameSessionId], references: [id])
  member             GroupMember @relation(fields: [memberId], references: [id])
  manualOverrideBy   User?       @relation("RegistrationManualOverrideBy", fields: [manualOverrideByUserId], references: [id], onDelete: Restrict)
  rotatingSetBy      User?       @relation("RegistrationRotatingSetBy", fields: [rotatingSetByUserId], references: [id], onDelete: Restrict)
  attendanceMarkedBy User?       @relation("RegistrationAttendanceMarkedBy", fields: [attendanceMarkedByUserId], references: [id], onDelete: Restrict)

  dailyFeeCharge   Charge?
  unavailabilities PlayerUnavailability[]

  @@unique([gameSessionId, memberId])
  @@index([gameSessionId, status, priorityTier, queueSortAt])
  @@index([memberId])
}

/// Período em que um participante fica indisponível durante a sessão (lesão, saída
/// antecipada), de startedAt até endedAt (nulo = ainda indisponível). Voltar a ficar
/// disponível fecha o período; uma nova indisponibilidade cria outro. Nada é apagado nem
/// sobrescrito. Não altera a inscrição, a presença real, as cobranças nem o time.
/// Disponível no instante t = nenhum período com startedAt <= t e (endedAt nulo ou
/// endedAt > t).
/// CHECK (SQL): reason não vazio; endedAt e endedByUserId ambos nulos ou ambos
/// preenchidos; endedAt > startedAt.
/// Invariantes (service):
/// - a inscrição é PARTICIPANT;
/// - períodos da mesma inscrição não se sobrepõem: um novo começa em ou depois do fim
///   do anterior;
/// - abrir e fechar travam a linha da GameSession, como a criação da Match.
model PlayerUnavailability {
  id                    String    @id @default(uuid(7)) @db.Uuid
  sessionRegistrationId String    @db.Uuid
  startedAt             DateTime  @db.Timestamptz(3)
  startedByUserId       String    @db.Uuid
  reason                String
  endedAt               DateTime? @db.Timestamptz(3)
  endedByUserId         String?   @db.Uuid

  sessionRegistration SessionRegistration @relation(fields: [sessionRegistrationId], references: [id])
  startedBy           User                @relation("UnavailabilityStartedBy", fields: [startedByUserId], references: [id])
  endedBy             User?               @relation("UnavailabilityEndedBy", fields: [endedByUserId], references: [id], onDelete: Restrict)

  /// PARCIAL: no máximo um período aberto por inscrição.
  /// Consultar com { sessionRegistrationId, endedAt: null }.
  @@unique([sessionRegistrationId], map: "PlayerUnavailability_open_key", where: { endedAt: null })
  @@index([sessionRegistrationId, startedAt])
}

// ============================================================================
// Panela de Aniversário
// ============================================================================

/// CHECK (SQL): version >= 1.
/// Invariantes (service): celebrantes e escolhidos são participantes da sessão; um
/// membro não é celebrante e escolhido ao mesmo tempo; total da panela = teamSize.
model BirthdayDraft {
  id            String              @id @default(uuid(7)) @db.Uuid
  gameSessionId String              @unique @db.Uuid
  status        BirthdayDraftStatus @default(BUILDING)
  /// Incrementada a cada mudança de composição; aprovações valem só para a versão atual.
  version       Int                 @default(1)
  finalizedAt   DateTime?           @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  gameSession GameSession              @relation(fields: [gameSessionId], references: [id])
  celebrants  BirthdayDraftCelebrant[]
  picks       BirthdayDraftPick[]
  approvals   BirthdayDraftApproval[]
  draws       Draw[]
}

model BirthdayDraftCelebrant {
  id              String   @id @default(uuid(7)) @db.Uuid
  birthdayDraftId String   @db.Uuid
  memberId        String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  birthdayDraft BirthdayDraft           @relation(fields: [birthdayDraftId], references: [id])
  member        GroupMember             @relation(fields: [memberId], references: [id])
  picksMade     BirthdayDraftPick[]
  approvals     BirthdayDraftApproval[]

  @@unique([birthdayDraftId, memberId])
}

model BirthdayDraftPick {
  id               String   @id @default(uuid(7)) @db.Uuid
  birthdayDraftId  String   @db.Uuid
  memberId         String   @db.Uuid
  pickedByMemberId String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  birthdayDraft BirthdayDraft          @relation(fields: [birthdayDraftId], references: [id])
  member        GroupMember            @relation(fields: [memberId], references: [id])
  /// Quem escolheu é celebrante desta mesma panela (FK composta).
  pickedBy      BirthdayDraftCelebrant @relation(fields: [birthdayDraftId, pickedByMemberId], references: [birthdayDraftId, memberId])

  @@unique([birthdayDraftId, memberId])
  @@index([birthdayDraftId, pickedByMemberId])
}

model BirthdayDraftApproval {
  id              String   @id @default(uuid(7)) @db.Uuid
  birthdayDraftId String   @db.Uuid
  memberId        String   @db.Uuid
  version         Int
  approvedAt      DateTime @default(now()) @db.Timestamptz(3)

  birthdayDraft BirthdayDraft          @relation(fields: [birthdayDraftId], references: [id])
  /// Só celebrantes desta mesma panela aprovam (FK composta).
  celebrant     BirthdayDraftCelebrant @relation(fields: [birthdayDraftId, memberId], references: [birthdayDraftId, memberId])

  @@unique([birthdayDraftId, memberId, version])
}

// ============================================================================
// Sorteio e votação (conteúdo imutável; refação manual cria novo Draw)
// ============================================================================

/// CHECK (SQL): status INVALIDATED se e somente se invalidatedAt preenchido;
/// invalidatedAt exige invalidatedByUserId e invalidationReason não vazio;
/// status DECIDED exige winningOptionId e decisionMethod.
/// O Draw DECIDED é o sorteio oficial. Invalidação só por refação manual de ADMIN antes
/// da primeira Match, inclusive de um Draw DECIDED; nada invalida um Draw
/// automaticamente (cancelamento, promoção, indisponibilidade, rotativos). Invalidar
/// preserva winningOptionId, decisionMethod e decidedAt, além das opções, times e votos.
/// A composição de cada opção é a dos participantes no momento da geração e não é
/// reescrita quando a inscrição de alguém muda depois.
/// Invariantes (service):
/// - invalidatedBy é ADMIN do grupo;
/// - replaces.gameSessionId = gameSessionId e replaces.status = INVALIDATED;
/// - birthdayDraft.gameSessionId = gameSessionId e birthdayDraftVersion = versão finalizada;
/// - criar, decidir ou invalidar um Draw só enquanto a sessão não tem nenhuma Match
///   (de qualquer status), com lock da linha da GameSession na transação.
model Draw {
  id                   String              @id @default(uuid(7)) @db.Uuid
  gameSessionId        String              @db.Uuid
  sequence             Int
  status               DrawStatus          @default(VOTING)
  decisionMethod       DrawDecisionMethod?
  winningOptionId      String?             @db.Uuid
  seed                 String
  algorithmVersion     String
  /// Estratégia avançada efetivamente usada: "A" | "C". Null em balance-v2 / histórico pré-estratégia.
  balancingStrategy    String?
  /// Snapshot de drawMinOptionDifference.
  minOptionDifference  Int
  /// Distância entre as opções A e B; nula com uma única opção.
  optionDistance       Int?
  /// Diagnóstico da geração (v3 metrics summary, fallback reason, missing attrs). Null em draws históricos v2.
  balanceDiagnostics   Json?
  birthdayDraftId      String?             @db.Uuid
  birthdayDraftVersion Int?
  createdByUserId      String?             @db.Uuid
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  votingClosedAt       DateTime?           @db.Timestamptz(3)
  decidedAt            DateTime?           @db.Timestamptz(3)
  decidedByUserId      String?             @db.Uuid
  invalidatedAt        DateTime?           @db.Timestamptz(3)
  invalidatedByUserId  String?             @db.Uuid
  invalidationReason   String?
  replacesDrawId       String?             @unique @db.Uuid

  gameSession   GameSession    @relation(fields: [gameSessionId], references: [id])
  /// A opção vencedora pertence a este Draw (FK composta).
  winningOption DrawOption?    @relation("DrawWinningOption", fields: [winningOptionId, id], references: [id, drawId], onDelete: Restrict)
  birthdayDraft BirthdayDraft? @relation(fields: [birthdayDraftId], references: [id], onDelete: Restrict)
  createdBy     User?          @relation("DrawCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  decidedBy     User?          @relation("DrawDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  invalidatedBy User?          @relation("DrawInvalidatedBy", fields: [invalidatedByUserId], references: [id], onDelete: Restrict)
  replaces      Draw?          @relation("DrawReplacement", fields: [replacesDrawId], references: [id], onDelete: Restrict)
  replacedBy    Draw?          @relation("DrawReplacement")

  options DrawOption[] @relation("DrawOptions")
  votes   DrawVote[]

  @@unique([gameSessionId, sequence])
  @@unique([winningOptionId, id])
  /// PARCIAL: no máximo um sorteio ativo (não invalidado) por sessão.
  /// Consultar com { gameSessionId, invalidatedAt: null }.
  @@unique([gameSessionId], map: "Draw_active_per_session_key", where: { invalidatedAt: null })
}

model DrawOption {
  id           String @id @default(uuid(7)) @db.Uuid
  drawId       String @db.Uuid
  /// A, B, ...
  label        String
  /// Somente ADMIN. Em v2/v3 = spread de Overall (compatível).
  balanceScore Float
  /// Métricas multi-eixo da opção (balance-v3). Null em draws v2.
  balanceMetrics Json?

  draw     Draw       @relation("DrawOptions", fields: [drawId], references: [id])
  winnerOf Draw?      @relation("DrawWinningOption")
  teams    DrawTeam[]
  votes    DrawVote[]

  @@unique([drawId, label])
  /// Alvo das FKs compostas que garantem que a opção pertence ao Draw informado.
  @@unique([id, drawId])
}

/// Invariante (service): no máximo um time BIRTHDAY e um ROTATION_POOL por opção, e
/// esses blocos são idênticos em todas as opções do Draw.
model DrawTeam {
  id            String   @id @default(uuid(7)) @db.Uuid
  drawOptionId  String   @db.Uuid
  position      Int
  name          String
  color         String?
  kind          TeamKind
  /// Somente ADMIN.
  strengthTotal Float

  drawOption   DrawOption       @relation(fields: [drawOptionId], references: [id])
  players      DrawTeamPlayer[]
  sessionTeams SessionTeam[]

  @@unique([drawOptionId, position])
  /// Alvo da FK composta de DrawTeamPlayer.
  @@unique([id, drawOptionId])
}

/// Um jogador aparece no máximo uma vez por opção de sorteio, somando todos os times
/// da opção, inclusive BIRTHDAY e ROTATION_POOL.
/// Invariante (service): o membro é PARTICIPANT da sessão do Draw.
model DrawTeamPlayer {
  id               String @id @default(uuid(7)) @db.Uuid
  drawTeamId       String @db.Uuid
  /// Cópia de drawTeam.drawOptionId, amarrada pela FK composta.
  drawOptionId     String @db.Uuid
  memberId         String @db.Uuid
  /// Somente ADMIN. Snapshot de Overall / força v2 na geração.
  strengthSnapshot Float
  /// Snapshots multi-atributo na geração (balance-v3). Null em draws v2 / rotativos sem attrs.
  attackSnapshot       Int?
  defenseSnapshot      Int?
  physicalSnapshot     Int?
  preferredRoleSnapshot PreferredRole?

  drawTeam DrawTeam    @relation(fields: [drawTeamId, drawOptionId], references: [id, drawOptionId])
  member   GroupMember @relation(fields: [memberId], references: [id])

  @@unique([drawOptionId, memberId])
  @@index([drawTeamId])
  @@index([memberId])
}

/// A opção votada pertence ao drawId informado (FK composta).
/// Invariantes (service), validadas na transação do voto:
/// - o votante é GroupMember com SessionRegistration PARTICIPANT na sessão do Draw e
///   modalitySnapshot MONTHLY (mensalista participante confirmado);
/// - o Draw está em VOTING.
model DrawVote {
  id            String   @id @default(uuid(7)) @db.Uuid
  drawId        String   @db.Uuid
  drawOptionId  String   @db.Uuid
  voterMemberId String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  draw       Draw        @relation(fields: [drawId], references: [id])
  drawOption DrawOption  @relation(fields: [drawOptionId, drawId], references: [id, drawId])
  voter      GroupMember @relation(fields: [voterMemberId], references: [id])

  @@unique([drawId, voterMemberId])
  @@index([drawOptionId, drawId])
  @@index([voterMemberId])
}

// ============================================================================
// Times finais, partidas e eventos
// ============================================================================

/// Times efetivos da noite e o time de cada jogador (SessionTeamPlayer). Os rotativos
/// ficam em um time de kind ROTATION_POOL. Quem atuou por qual lado em cada partida,
/// inclusive emprestado, está em MatchPlayer.
/// Ciclo de vida:
/// - Antes da primeira Match da sessão: cópia do Draw decidido. Só a refação manual do
///   sorteio, na mesma transação que invalida o Draw, apaga SessionTeamPlayer e
///   SessionTeam da sessão; o AuditLog guarda a composição substituída em before. Os
///   novos times são gerados só a partir do novo Draw decidido.
/// - Depois da primeira Match (de qualquer status): histórico. Nunca são apagados,
///   regenerados nem movidos de time. Lesão ou saída antecipada é PlayerUnavailability;
///   reposições são empréstimos por partida em MatchPlayer. As FKs
///   Restrict de Match, MatchPlayer e MatchEvent impedem no banco a exclusão dos times
///   que já jogaram.
/// Invariantes (service):
/// - no máximo um time BIRTHDAY e um ROTATION_POOL por sessão;
/// - sourceDrawTeam, quando presente, pertence à opção vencedora do Draw ativo (não
///   invalidado) da sessão;
/// - exclusão só enquanto a sessão não tem nenhuma Match, com lock da linha da
///   GameSession na transação.
model SessionTeam {
  id                   String            @id @default(uuid(7)) @db.Uuid
  gameSessionId        String            @db.Uuid
  sourceDrawTeamId     String?           @db.Uuid
  origin               SessionTeamOrigin
  kind                 TeamKind
  name                 String
  color                String?
  /// Ordem inicial no Rei da Mesa; nula para ROTATION_POOL.
  initialQueuePosition Int?
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)

  gameSession    GameSession         @relation(fields: [gameSessionId], references: [id])
  sourceDrawTeam DrawTeam?           @relation(fields: [sourceDrawTeamId], references: [id], onDelete: Restrict)
  players        SessionTeamPlayer[]
  matchesAsA     Match[]             @relation("MatchTeamA")
  matchesAsB     Match[]             @relation("MatchTeamB")
  penaltyWins    Match[]             @relation("MatchPenaltyWinner")
  matchPlayers        MatchPlayer[]
  matchEvents         MatchEvent[]
  matchSubstitutions  MatchSubstitution[]

  @@unique([gameSessionId, initialQueuePosition])
  /// Alvo das FKs compostas de SessionTeamPlayer e Match.
  @@unique([id, gameSessionId])
}

/// Um jogador pertence a no máximo um time da sessão, somando REGULAR, BIRTHDAY e
/// ROTATION_POOL. Quem completa lacunas durante a noite aparece em MatchPlayer, não aqui.
/// É o time do jogador na noite: não muda quando ele é emprestado a outro time em uma
/// partida nem quando fica indisponível (PlayerUnavailability).
/// Invariante (service): o membro é PARTICIPANT da sessão quando a linha é criada. Uma
/// mudança posterior na inscrição não reescreve a composição oficial; quem deixou de ser
/// PARTICIPANT simplesmente não entra em MatchPlayer.
model SessionTeamPlayer {
  id            String   @id @default(uuid(7)) @db.Uuid
  sessionTeamId String   @db.Uuid
  /// Cópia de sessionTeam.gameSessionId, amarrada pela FK composta.
  gameSessionId String   @db.Uuid
  memberId      String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  sessionTeam SessionTeam @relation(fields: [sessionTeamId, gameSessionId], references: [id, gameSessionId])
  member      GroupMember @relation(fields: [memberId], references: [id])

  @@unique([gameSessionId, memberId])
  @@index([sessionTeamId])
  @@index([memberId])
}

/// Os times A, B e o vencedor nos pênaltis são da mesma sessão da partida (FKs compostas).
/// CHECK (SQL): teamAId <> teamBId; penaltyWinnerTeamId nulo ou igual a teamAId/teamBId;
/// version >= 0; pausedTotalMs >= 0.
/// Invariante (service): a criação trava a linha da GameSession, serializando com a
/// refação do sorteio; a existência de qualquer Match encerra a fase de refação.
model Match {
  id                  String      @id @default(uuid(7)) @db.Uuid
  gameSessionId       String      @db.Uuid
  sequence            Int
  teamAId             String      @db.Uuid
  teamBId             String      @db.Uuid
  status              MatchStatus @default(IN_PROGRESS)
  startedAt           DateTime    @db.Timestamptz(3)
  pausedAt            DateTime?   @db.Timestamptz(3)
  pausedTotalMs       Int         @default(0)
  endedAt             DateTime?   @db.Timestamptz(3)
  /// Snapshot de GameSession.matchDurationSec.
  plannedDurationSec  Int
  penaltyWinnerTeamId String?     @db.Uuid
  /// Versionamento otimista: incrementada a cada comando aceito.
  version             Int         @default(0)
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)

  gameSession   GameSession   @relation(fields: [gameSessionId], references: [id])
  teamA         SessionTeam   @relation("MatchTeamA", fields: [teamAId, gameSessionId], references: [id, gameSessionId])
  teamB         SessionTeam   @relation("MatchTeamB", fields: [teamBId, gameSessionId], references: [id, gameSessionId])
  penaltyWinner SessionTeam?  @relation("MatchPenaltyWinner", fields: [penaltyWinnerTeamId, gameSessionId], references: [id, gameSessionId], onDelete: Restrict)
  players        MatchPlayer[]
  events         MatchEvent[]
  substitutions  MatchSubstitution[]

  @@unique([gameSessionId, sequence])
  /// PARCIAL: no máximo uma partida em andamento por sessão.
  /// Consultar com { gameSessionId, status: "IN_PROGRESS" }.
  @@unique([gameSessionId], map: "Match_in_progress_per_session_key", where: { status: "IN_PROGRESS" })
  @@index([teamAId])
  @@index([teamBId])
}

/// Quem efetivamente jogou a partida (inclui rotativos e goleiros escolhidos na hora).
/// teamId é o lado em que o jogador atuou nesta partida, não necessariamente o seu
/// SessionTeam. Sem FK para SessionTeamPlayer: o membro pode não ter time na sessão.
/// - Emprestado: tem SessionTeamPlayer e teamId é outro time; vale só para esta partida
///   e não muda o time dele na noite.
/// - Participante sem time: PARTICIPANT sem SessionTeamPlayer (entrou depois do sorteio
///   oficial, sem refação); preenche vaga por aqui, sem alterar o sorteio.
/// - Substituição ao vivo: leftAt marca saída; o substituto entra no mesmo teamId.
///   SessionTeamPlayer e disponibilidade da noite NÃO mudam.
/// - Reentrada: limpa leftAt sem sobrescrever enteredAt/teamId; o histórico de trocas
///   fica em MatchSubstitution (append-only). PJ/V/E/D continuam nesta linha.
/// O unique (matchId, memberId) impede o mesmo jogador nos dois lados da partida.
/// Invariantes (service):
/// - teamId é match.teamAId ou match.teamBId; o membro é PARTICIPANT da sessão;
/// - emprestado vem de um time que não está nesta partida (ou sem time na noite);
/// - o membro está disponível (sem PlayerUnavailability aberta) no instante em que entra
///   na partida: match.startedAt na escalação inicial, o momento do comando quando entra
///   durante a partida;
/// - leftAt nulo = em campo; eventos novos só para quem está em campo;
/// - teamId e enteredAt (1ª entrada) não mudam em reentrada.
model MatchPlayer {
  id        String          @id @default(uuid(7)) @db.Uuid
  matchId   String          @db.Uuid
  memberId  String          @db.Uuid
  teamId    String          @db.Uuid
  role      MatchPlayerRole
  /// Primeira entrada em campo nesta partida (escalação ou 1ª substituição).
  enteredAt DateTime        @default(now()) @db.Timestamptz(3)
  /// Instantâneo em que saiu (substituição). Nulo = ainda em campo.
  leftAt    DateTime?       @db.Timestamptz(3)

  match  Match       @relation(fields: [matchId], references: [id])
  member GroupMember @relation(fields: [memberId], references: [id])
  team   SessionTeam @relation(fields: [teamId], references: [id])

  @@unique([matchId, memberId])
  @@index([memberId])
  @@index([teamId])
}

/// Histórico append-only de substituições (inclui reentradas). Não altera PJ.
model MatchSubstitution {
  id              String   @id @default(uuid(7)) @db.Uuid
  matchId         String   @db.Uuid
  outMemberId     String   @db.Uuid
  inMemberId      String   @db.Uuid
  /// Lado preservado da substituição (teamId de quem saiu).
  teamId          String   @db.Uuid
  substitutedAt   DateTime @db.Timestamptz(3)
  createdByUserId String   @db.Uuid
  /// Só rastreabilidade (idempotência via IdempotentOperation).
  operationId     String?  @db.Uuid

  match     Match       @relation(fields: [matchId], references: [id])
  outMember GroupMember @relation("MatchSubstitutionOut", fields: [outMemberId], references: [id])
  inMember  GroupMember @relation("MatchSubstitutionIn", fields: [inMemberId], references: [id])
  team      SessionTeam @relation(fields: [teamId], references: [id])
  createdBy User        @relation("MatchSubstitutionCreatedBy", fields: [createdByUserId], references: [id])

  @@index([matchId, substitutedAt])
  @@index([outMemberId])
  @@index([inMemberId])
}

/// CHECK (SQL): assistMemberId só em GOAL e diferente de memberId; elapsedSec >= 0;
/// voidedAt exige voidedByUserId e voidReason não vazio.
/// Invariantes (service): teamId é match.teamAId ou match.teamBId; autor e assistente
/// são MatchPlayer desta partida no lado teamId.
/// Placar: só GOAL e OWN_GOAL (OWN_GOAL credita o adversário). Cartões, pixotada,
/// trave e desarme são registros sem efeito no placar nem suspensão automática.
model MatchEvent {
  id              String         @id @default(uuid(7)) @db.Uuid
  matchId         String         @db.Uuid
  type            MatchEventType
  /// Autor, obrigatório em todos os tipos.
  memberId        String         @db.Uuid
  /// Lado em que o autor atuou nesta partida (MatchPlayer.teamId), mesmo emprestado.
  /// Em OWN_GOAL o placar é creditado ao adversário.
  teamId          String         @db.Uuid
  assistMemberId  String?        @db.Uuid
  elapsedSec      Int
  createdByUserId String         @db.Uuid
  /// Só rastreabilidade: NÃO implementa idempotência (ver IdempotentOperation).
  /// Sem unique e sem FK, porque IdempotentOperation é expurgada.
  operationId     String?        @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  voidedAt        DateTime?      @db.Timestamptz(3)
  voidedByUserId  String?        @db.Uuid
  voidReason      String?

  match     Match        @relation(fields: [matchId], references: [id])
  member    GroupMember  @relation("MatchEventAuthor", fields: [memberId], references: [id])
  team      SessionTeam  @relation(fields: [teamId], references: [id])
  assist    GroupMember? @relation("MatchEventAssist", fields: [assistMemberId], references: [id], onDelete: Restrict)
  createdBy User         @relation("MatchEventCreatedBy", fields: [createdByUserId], references: [id])
  voidedBy  User?        @relation("MatchEventVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([memberId, type])
  @@index([assistMemberId])
  @@index([teamId])
}

// ============================================================================
// Financeiro
// ============================================================================

/// Ciclo financeiro mensal: a mensalidade e o campo do mês referenceMonth (M).
/// freezesAt padrão = sexta 08:00 após a primeira quinta regular do mês M (fuso do Group).
/// Só crédito APROVADO pelo ADMIN reduz a mensalidade (carriedCreditCents no freeze).
/// eligibleDailyRevenueCents no CLOSED = snapshot do saldo elegível disponível (não auto-aplicado).
/// approvedCreditCents pode ser definido enquanto OPEN; no freeze vira carriedCreditCents.
/// CHECK: amountToSplitCents = max(fieldCostSnapshotCents - carriedCreditCents, 0);
/// carriedCreditCents <= max(eligibleDailyRevenueCents, 0) no CLOSED REGULAR.
model BillingCycle {
  id                     String             @id @default(uuid(7)) @db.Uuid
  groupId                String             @db.Uuid
  /// Primeiro dia do mês de referência.
  referenceMonth         DateTime           @db.Date
  kind                   BillingCycleKind   @default(REGULAR)
  status                 BillingCycleStatus @default(OPEN)
  openedAt               DateTime           @default(now()) @db.Timestamptz(3)
  /// Corte de ativação/congelamento (padrão: sexta 08:00 após 1ª quinta do mês).
  freezesAt              DateTime           @db.Timestamptz(3)
  /// Instante em que o congelamento foi executado (>= freezesAt).
  closedAt               DateTime?          @db.Timestamptz(3)
  /// Nulo = congelado pelo SYSTEM (job ou avaliação preguiçosa).
  closedByUserId         String?            @db.Uuid
  /// Prazo de pagamento da mensalidade (dia monthlyFeeDueDay de referenceMonth).
  monthlyFeeDueDate      DateTime           @db.Date
  /// Prazo do pagamento do campo (dia fieldPaymentDueDay de referenceMonth).
  fieldPaymentDueDate    DateTime           @db.Date
  fieldCostSnapshotCents Int

  /// Crédito aprovado pelo ADMIN enquanto OPEN (0/null = nenhum). Congelado em carriedCreditCents.
  approvedCreditCents       Int?

  // Congelados no congelamento
  /// Snapshot do surplus elegível disponível no corte (diárias antes do corte + prior unallocated).
  eligibleDailyRevenueCents Int?
  /// Crédito efetivamente aplicado (= approved no freeze; 0 se não houve aprovação).
  carriedCreditCents        Int?
  carriedFromCycleId        String? @unique @db.Uuid
  amountToSplitCents        Int?
  payingMonthlyCount        Int?
  monthlyFeeCents           Int?
  totalChargedCents         Int?
  roundingDifferenceCents   Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  group       Group         @relation(fields: [groupId], references: [id])
  closedBy    User?         @relation(fields: [closedByUserId], references: [id], onDelete: Restrict)
  carriedFrom BillingCycle? @relation("BillingCycleCarriedCredit", fields: [carriedFromCycleId], references: [id], onDelete: Restrict)
  carriedInto BillingCycle? @relation("BillingCycleCarriedCredit")

  charges          Charge[]
  cashTransactions CashTransaction[]
  creditAllocationsAsTarget BillingCreditAllocation[] @relation("CreditAllocationTarget")
  creditAllocationsAsSource BillingCreditAllocation[] @relation("CreditAllocationSource")
  accessGrantsExpiring      FinancialAccessGrant[]

  @@unique([groupId, referenceMonth])
  /// PARCIAL: no máximo um ciclo de implantação por grupo.
  /// Consultar com { groupId, kind: "OPENING" }.
  @@unique([groupId], map: "BillingCycle_opening_per_group_key", where: { kind: "OPENING" })
  @@index([groupId, status, referenceMonth])
}

/// Aprovação explícita de crédito discricionário para um ciclo OPEN.
/// No máximo uma linha APPROVED por targetCycleId; supersessões marcam SUPERSEDED.
model BillingCreditAllocation {
  id                     String                        @id @default(uuid(7)) @db.Uuid
  groupId                String                        @db.Uuid
  targetCycleId          String                        @db.Uuid
  sourceCycleId          String?                       @db.Uuid
  amountCents            Int
  availableSnapshotCents Int
  priorUnallocatedCents  Int
  dailyEligibleCents     Int
  approvedByUserId       String                        @db.Uuid
  approvedAt             DateTime                      @db.Timestamptz(3)
  appliedAt              DateTime?                     @db.Timestamptz(3)
  status                 BillingCreditAllocationStatus @default(APPROVED)
  notes                  String?
  createdAt              DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                      @updatedAt @db.Timestamptz(3)

  group      Group        @relation(fields: [groupId], references: [id])
  targetCycle BillingCycle @relation("CreditAllocationTarget", fields: [targetCycleId], references: [id], onDelete: Restrict)
  sourceCycle BillingCycle? @relation("CreditAllocationSource", fields: [sourceCycleId], references: [id], onDelete: Restrict)
  approvedBy User         @relation("BillingCreditApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@unique([targetCycleId], map: "BillingCreditAllocation_one_approved_per_target_key", where: { status: "APPROVED" })
  @@index([groupId, targetCycleId])
}

/// Obrigação de um jogador. DAILY_FEE liga-se à inscrição e à sessão, sem ciclo (o ciclo
/// da receita é o da CashTransaction); MONTHLY_FEE liga-se ao ciclo e ao membro.
/// CHECK (SQL): amountCents > 0; DAILY_FEE exige gameSessionId e sessionRegistrationId,
/// com billingCycleId e monthlyFeeOrigin nulos; MONTHLY_FEE exige billingCycleId e
/// monthlyFeeOrigin, com gameSessionId e sessionRegistrationId nulos; status CANCELLED
/// exige cancelledAt e cancelReason não vazio.
/// Invariantes (service):
/// - member.groupId = groupId e billingCycle.groupId = groupId;
/// - DAILY_FEE: sessionRegistration.gameSessionId = gameSessionId,
///   sessionRegistration.memberId = memberId;
/// - MONTHLY_FEE: billingCycle CLOSED e amountCents = billingCycle.monthlyFeeCents (> 0);
///   CYCLE_FREEZE só na transação do congelamento de um ciclo REGULAR, uma por pagante
///   (quantidade = payingMonthlyCount); OPENING só na implantação; LATE_JOIN só no
///   cadastro de um novo mensalista (permitido do dia 1 ao 7), criada travando o ciclo do
///   mês (FOR SHARE) para não concorrer com o congelamento;
/// - status PAID se e somente se a soma dos Payment CONFIRMED >= amountCents;
///   pagamentos parciais mantêm PENDING e outstanding = amount - soma confirmada;
/// - cancelar (PRESENT -> ABSENT) só a partir de PENDING sem pagamento confirmado,
///   com reason e AuditLog; reativar é CANCELLED -> PENDING na MESMA linha;
///   com qualquer pagamento confirmado, o estorno vem antes.
model Charge {
  id                    String            @id @default(uuid(7)) @db.Uuid
  groupId               String            @db.Uuid
  memberId              String            @db.Uuid
  /// Só MONTHLY_FEE.
  billingCycleId        String?           @db.Uuid
  type                  ChargeType
  /// Só MONTHLY_FEE.
  monthlyFeeOrigin      MonthlyFeeOrigin?
  gameSessionId         String?           @db.Uuid
  /// Uma cobrança de diária por participação, para sempre: correções de presença
  /// cancelam e reativam esta mesma linha, nunca criam outra.
  sessionRegistrationId String?           @unique @db.Uuid
  /// Snapshot da diária da sessão ou da mensalidade congelada do ciclo.
  amountCents           Int
  status                ChargeStatus      @default(PENDING)
  createdByUserId       String?           @db.Uuid
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
  cancelledAt           DateTime?         @db.Timestamptz(3)
  cancelledByUserId     String?           @db.Uuid
  cancelReason          String?

  group               Group                @relation(fields: [groupId], references: [id])
  member              GroupMember          @relation(fields: [memberId], references: [id])
  billingCycle        BillingCycle?        @relation(fields: [billingCycleId], references: [id], onDelete: Restrict)
  gameSession         GameSession?         @relation(fields: [gameSessionId], references: [id], onDelete: Restrict)
  sessionRegistration SessionRegistration? @relation(fields: [sessionRegistrationId], references: [id], onDelete: Restrict)
  createdBy           User?                @relation("ChargeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledBy         User?                @relation("ChargeCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  payments Payment[]
  receipts PaymentReceipt[]
  accessGrants FinancialAccessGrant[]

  /// PARCIAL: uma mensalidade por mensalista por ciclo, qualquer que seja a origem
  /// (CYCLE_FREEZE, LATE_JOIN ou OPENING).
  /// Consultar com { billingCycleId, memberId, type: "MONTHLY_FEE" }.
  @@unique([billingCycleId, memberId], map: "Charge_monthly_fee_per_cycle_key", where: { type: "MONTHLY_FEE" })
  @@index([groupId, status])
  @@index([billingCycleId, type])
  @@index([memberId, status])
  @@index([gameSessionId])
}

/// Pagamento (integral ou parcial) de uma cobrança, confirmado por ADMIN.
/// Vários CONFIRMED por Charge são permitidos desde que a soma ≤ charge.amountCents.
/// Nunca apagado: estorno muda para REVERSED; correção = estorno + novo Payment com
/// correctsPaymentId. Idempotência via IdempotentOperation (operationId).
/// paidAt = quando o jogador pagou; confirmedAt = confirmação (relógio do banco).
/// Atribuição de diária ao ciclo usa confirmedAt (ver CashTransaction).
/// Invariantes (service):
/// - amountCents > 0, amountCents <= saldo em aberto, memberId = charge.memberId;
/// - Charge só vira PAID quando a soma dos CONFIRMED cobre amountCents;
/// - estorno: Payment -> REVERSED + CashTransaction de estorno; Charge volta a PENDING
///   se a soma restante < amountCents.
model Payment {
  id                String         @id @default(uuid(7)) @db.Uuid
  chargeId          String         @db.Uuid
  memberId          String         @db.Uuid
  amountCents       Int
  paidAt            DateTime       @db.Timestamptz(3)
  confirmedAt       DateTime       @db.Timestamptz(3)
  confirmedByUserId String         @db.Uuid
  method            PaymentMethod?
  notes             String?
  status            PaymentStatus  @default(CONFIRMED)
  reversedAt        DateTime?      @db.Timestamptz(3)
  reversedByUserId  String?        @db.Uuid
  reversalReason    String?
  correctsPaymentId String?        @unique @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  charge      Charge      @relation(fields: [chargeId], references: [id])
  member      GroupMember @relation(fields: [memberId], references: [id])
  confirmedBy User        @relation("PaymentConfirmedBy", fields: [confirmedByUserId], references: [id])
  reversedBy  User?       @relation("PaymentReversedBy", fields: [reversedByUserId], references: [id], onDelete: Restrict)
  corrects    Payment?    @relation("PaymentCorrection", fields: [correctsPaymentId], references: [id], onDelete: Restrict)
  correctedBy Payment?    @relation("PaymentCorrection")

  cashTransactions CashTransaction[]
  receipts         PaymentReceipt[]

  @@index([chargeId])
  @@index([memberId])
}

/// Comprovante de pagamento enviado pelo jogador (armazenamento privado fora do AuditLog).
/// Aprovação Admin confirma Payment; upload NÃO quita nem libera acesso.
model PaymentReceipt {
  id                 String               @id @default(uuid(7)) @db.Uuid
  groupId            String               @db.Uuid
  chargeId           String               @db.Uuid
  memberId           String               @db.Uuid
  uploadedByUserId   String               @db.Uuid
  /// Chave opaca no storage (nunca URL pública).
  storageKey         String
  mimeType           String
  byteSize           Int
  originalFilename   String
  /// SHA-256 do conteúdo para dedupe / integridade.
  contentSha256      String
  status             PaymentReceiptStatus @default(PENDING_REVIEW)
  /// Valor pretendido (opcional); Admin decide o valor aprovado.
  claimedAmountCents Int?
  rejectionReason    String?
  reviewedAt         DateTime?            @db.Timestamptz(3)
  reviewedByUserId   String?              @db.Uuid
  /// Preenchido quando APPROVED e o Payment correspondente foi criado.
  paymentId          String?              @db.Uuid
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)

  group      Group      @relation(fields: [groupId], references: [id])
  charge     Charge     @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  member     GroupMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  uploadedBy User       @relation("PaymentReceiptUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation("PaymentReceiptReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  payment    Payment?   @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([groupId, status, createdAt])
  @@index([chargeId, status])
  @@index([memberId, createdAt])
  @@unique([chargeId, contentSha256], map: "PaymentReceipt_charge_content_unique")
}

/// Liberação excepcional de acesso com dívida. Expiração avaliada na requisição (sem job).
/// MONTHLY: expira no freezesAt do ciclo seguinte ao relatedCharge.billingCycleId.
/// DAILY: expira quando surgir nova Charge DAILY_FEE do membro com createdAt > grantedAt.
model FinancialAccessGrant {
  id               String                   @id @default(uuid(7)) @db.Uuid
  groupId          String                   @db.Uuid
  memberId         String                   @db.Uuid
  kind             FinancialAccessGrantKind
  relatedChargeId  String                   @db.Uuid
  /// Para MONTHLY: ciclo cuja ativação (freezesAt) encerra a liberação.
  expiresAtCycleId String?                  @db.Uuid
  reason           String
  grantedAt        DateTime                 @db.Timestamptz(3)
  grantedByUserId  String                   @db.Uuid
  revokedAt        DateTime?                @db.Timestamptz(3)
  revokedByUserId  String?                  @db.Uuid
  revokeReason     String?
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3)

  group          Group         @relation(fields: [groupId], references: [id])
  member         GroupMember   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  relatedCharge  Charge        @relation(fields: [relatedChargeId], references: [id], onDelete: Restrict)
  expiresAtCycle BillingCycle? @relation(fields: [expiresAtCycleId], references: [id], onDelete: Restrict)
  grantedBy      User          @relation("FinancialAccessGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedBy      User?         @relation("FinancialAccessRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([groupId, memberId, revokedAt])
  @@index([relatedChargeId])
  @@index([expiresAtCycleId])
}

/// Ledger append-only do caixa. O saldo nunca é armazenado.
/// Estorno = mesma categoria, direção oposta e reversesTransactionId.
/// CHECK (SQL): amountCents > 0; paymentId preenchido se e somente se category é
/// DAILY_FEE ou MONTHLY_FEE; direção natural (IN para DAILY_FEE, MONTHLY_FEE e
/// INITIAL_BALANCE; OUT para FIELD_COST e OTHER_EXPENSE; ADJUSTMENT IN ou OUT)
/// sem reversesTransactionId e oposta com ele; reason obrigatório em INITIAL_BALANCE,
/// OTHER_EXPENSE, ADJUSTMENT e estornos; reversesTransactionId <> id.
/// Invariantes (service):
/// - billingCycle.groupId = groupId; payment pertence a uma Charge do mesmo Group;
/// - o estorno tem o mesmo groupId, category, paymentId e amountCents do original;
/// - no máximo um INITIAL_BALANCE não estornado por grupo;
/// - o saldo do caixa do grupo (Σ IN - Σ OUT, nunca armazenado) nunca fica negativo:
///   todo lançamento OUT (FIELD_COST ou estorno de entrada) trava a linha do Group,
///   recalcula o saldo e é rejeitado se amountCents exceder o saldo disponível; o valor
///   nunca é reduzido para caber no saldo;
/// - atribuição de billingCycleId (PROJECT.md 31.6), gravada uma vez e nunca recalculada:
///   - DAILY_FEE (confirmação e estorno): o ciclo de menor referenceMonth com
///     freezesAt > recordedAt, onde recordedAt = payment.confirmedAt (entrada) ou
///     payment.reversedAt (estorno). Como paidAt <= confirmedAt, uma diária paga ou
///     confirmada no mês M nunca reduz a mensalidade de M. O service trava o ciclo-alvo
///     (FOR SHARE), lê o relógio depois do lock e, se o corte passou durante a espera,
///     passa ao ciclo seguinte. O alvo é sempre REGULAR e OPEN: o congelamento trava o
///     ciclo FOR UPDATE, então espera a confirmação e a inclui, ou terminou antes e o
///     relógio lido depois do lock já passou do corte;
///   - MONTHLY_FEE (entrada e estorno): o ciclo da Charge, mesmo CLOSED;
///   - FIELD_COST: o ciclo cujo campo está sendo pago, informado pelo ADMIN;
///   - INITIAL_BALANCE (e estorno): o ciclo OPENING.
model CashTransaction {
  id                    String         @id @default(uuid(7)) @db.Uuid
  groupId               String         @db.Uuid
  /// Ciclo ao qual a movimentação foi atribuída no lançamento; nunca recalculado.
  billingCycleId        String         @db.Uuid
  direction             CashDirection
  amountCents           Int
  category              CashCategory
  reason                String?
  /// Data real do dinheiro (em pagamentos, payment.paidAt).
  occurredAt            DateTime       @db.Timestamptz(3)
  /// Instante do lançamento. Em DAILY_FEE é gravado explicitamente igual a
  /// payment.confirmedAt / payment.reversedAt e é o instante usado na atribuição.
  recordedAt            DateTime       @default(now()) @db.Timestamptz(3)
  paymentId             String?        @db.Uuid
  gameSessionId         String?        @db.Uuid
  reversesTransactionId String?        @unique @db.Uuid
  method                PaymentMethod?
  notes                 String?
  createdByUserId       String         @db.Uuid

  group        Group            @relation(fields: [groupId], references: [id])
  billingCycle BillingCycle     @relation(fields: [billingCycleId], references: [id])
  payment      Payment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  gameSession  GameSession?     @relation(fields: [gameSessionId], references: [id], onDelete: Restrict)
  reverses     CashTransaction? @relation("CashTransactionReversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict)
  reversedBy   CashTransaction? @relation("CashTransactionReversal")
  createdBy    User             @relation(fields: [createdByUserId], references: [id])

  /// PARCIAL: um único lançamento original por pagamento (o estorno é o segundo).
  /// Consultar com { paymentId, reversesTransactionId: null }.
  @@unique([paymentId], map: "CashTransaction_original_per_payment_key", where: { reversesTransactionId: null })
  @@index([groupId, occurredAt])
  @@index([billingCycleId, category])
  @@index([paymentId])
  @@index([gameSessionId])
}

// ============================================================================
// Comandos, notificações e auditoria
// ============================================================================

/// Única fonte de idempotência dos comandos. Gravado na mesma transação do efeito;
/// um reenvio com o mesmo operationId devolve resultJson sem repetir o efeito.
/// Mesmo operationId com outro ator ou outro requestHash é rejeitado.
/// Expurgado após N dias (por isso nenhuma tabela tem FK para cá).
model IdempotentOperation {
  operationId String   @id @db.Uuid
  groupId     String   @db.Uuid
  actorUserId String   @db.Uuid
  commandType String
  requestHash String
  targetType  String?
  targetId    String?
  resultJson  Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id])
  actor User  @relation(fields: [actorUserId], references: [id])

  @@index([createdAt])
}

model PushSubscription {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  lastSuccessAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]

  @@index([userId])
}

/// Outbox de notificações e caixa de entrada in-app.
/// Invariante (service): o destinatário é membro do Group.
model Notification {
  id              String           @id @default(uuid(7)) @db.Uuid
  groupId         String           @db.Uuid
  recipientUserId String           @db.Uuid
  type            NotificationType
  title           String
  body            String
  /// Ex.: { url, gameSessionId }.
  data            Json?
  dedupeKey       String           @unique
  readAt          DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  group      Group                  @relation(fields: [groupId], references: [id])
  recipient  User                   @relation(fields: [recipientUserId], references: [id])
  deliveries NotificationDelivery[]

  @@index([recipientUserId, createdAt])
}

model NotificationDelivery {
  id             String         @id @default(uuid(7)) @db.Uuid
  notificationId String         @db.Uuid
  /// Nulo depois que a inscrição expirada é removida.
  subscriptionId String?        @db.Uuid
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  lastError      String?
  nextAttemptAt  DateTime?      @db.Timestamptz(3)
  sentAt         DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  notification Notification      @relation(fields: [notificationId], references: [id])
  subscription PushSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([notificationId, subscriptionId])
  @@index([status, nextAttemptAt])
}

/// Append-only. action e entityType são strings tipadas no código (AuditAction, AuditEntityType).
/// Invariante (service): gameSession, quando presente, é do mesmo Group.
/// outcome/severity/correlationId/durationMs: null = registros legados (tratar outcome como SUCCESS na UI).
model AuditLog {
  id            String    @id @default(uuid(7)) @db.Uuid
  groupId       String    @db.Uuid
  actorType     ActorType
  actorUserId   String?   @db.Uuid
  action        String
  entityType    String
  entityId      String
  before        Json?
  after         Json?
  reason        String?
  gameSessionId String?   @db.Uuid
  /// Só rastreabilidade do comando que originou o registro.
  operationId   String?   @db.Uuid
  /// SUCCESS | FAILURE | DENIED — null = legado.
  outcome       String?
  /// INFO | WARN | ERROR — null = legado.
  severity      String?
  /// Correlação de request/comando (pode coincidir com operationId).
  correlationId String?
  durationMs    Int?
  /// Ex.: { expectedVersion, newVersion }.
  metadata      Json?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  group       Group        @relation(fields: [groupId], references: [id])
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  gameSession GameSession? @relation(fields: [gameSessionId], references: [id], onDelete: Restrict)

  @@index([groupId, createdAt])
  @@index([entityType, entityId])
  @@index([gameSessionId])
  @@index([groupId, action, createdAt])
  @@index([groupId, actorUserId, createdAt])
  @@index([groupId, outcome, createdAt])
  @@index([correlationId])
}

// ============================================================================
// Notas comunitárias (Fase 1 — fundação; flags OFF)
// ============================================================================

/// Proposta de alteração de UM atributo de nota.
/// CHECK (SQL): toValue 1–5; fromValue NULL ou 1–5; motivos não vazios quando exigidos pelo status.
/// PARCIAL: no máximo uma proposta com blocksDuplicate=true por (group, target, attribute).
model RatingChangeProposal {
  id              String               @id @default(uuid(7)) @db.Uuid
  groupId         String               @db.Uuid
  targetMemberId  String               @db.Uuid
  attribute       RatingAttribute
  /// Snapshot no momento da sugestão (null = atributo ainda sem nota).
  fromValue       Int?
  toValue         Int
  reason          String
  status          RatingProposalStatus @default(PENDING_ADMIN_REVIEW)
  /// true enquanto PENDING_ADMIN_REVIEW | OPEN_FOR_VOTING | VOTING_CLOSED.
  blocksDuplicate Boolean              @default(true)

  proposedByMemberId String   @db.Uuid
  proposedAt         DateTime @default(now()) @db.Timestamptz(3)

  initialReviewedByUserId String?   @db.Uuid
  initialReviewedAt       DateTime? @db.Timestamptz(3)
  initialReviewReason     String?

  votingClosedByUserId String?   @db.Uuid
  votingClosedAt       DateTime? @db.Timestamptz(3)

  finalDecidedByUserId String?   @db.Uuid
  finalDecidedAt       DateTime? @db.Timestamptz(3)
  finalDecisionReason  String?

  /// Congelados ao fechar a votação.
  forCount     Int @default(0)
  againstCount Int @default(0)

  appliedPreviousValue Int?
  appliedNewValue      Int?
  appliedAt            DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  group         Group       @relation(fields: [groupId], references: [id])
  targetMember  GroupMember @relation("RatingProposalTarget", fields: [targetMemberId], references: [id])
  proposedBy    GroupMember @relation("RatingProposalProposer", fields: [proposedByMemberId], references: [id])
  initialReviewedBy User?   @relation("RatingProposalInitialReviewedBy", fields: [initialReviewedByUserId], references: [id], onDelete: Restrict)
  votingClosedBy    User?   @relation("RatingProposalVotingClosedBy", fields: [votingClosedByUserId], references: [id], onDelete: Restrict)
  finalDecidedBy    User?   @relation("RatingProposalFinalDecidedBy", fields: [finalDecidedByUserId], references: [id], onDelete: Restrict)

  votes   RatingChangeVote[]
  history MemberRatingHistory[]

  @@unique([groupId, targetMemberId, attribute], map: "RatingChangeProposal_active_attr_key", where: { blocksDuplicate: true })
  @@index([groupId, status, proposedAt])
  @@index([groupId, targetMemberId, status])
  @@index([proposedByMemberId])
}

model RatingChangeVote {
  id             String           @id @default(uuid(7)) @db.Uuid
  proposalId     String           @db.Uuid
  voterMemberId  String           @db.Uuid
  choice         RatingVoteChoice
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  proposal RatingChangeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  voter    GroupMember          @relation(fields: [voterMemberId], references: [id])

  @@unique([proposalId, voterMemberId])
  @@index([voterMemberId])
}

model MemberRatingHistory {
  id           String                   @id @default(uuid(7)) @db.Uuid
  groupId      String                   @db.Uuid
  memberId     String                   @db.Uuid
  attribute    RatingAttribute
  previousValue Int?
  /// Null = atributo opcional limpo (Attack/Defense/Physical). Overall nunca é null.
  newValue      Int?
  source        MemberRatingChangeSource
  actorUserId   String                   @db.Uuid
  reason        String?
  proposalId    String?                  @db.Uuid
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)

  group    Group                 @relation(fields: [groupId], references: [id])
  member   GroupMember           @relation(fields: [memberId], references: [id])
  actor    User                  @relation("MemberRatingHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  proposal RatingChangeProposal? @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  @@index([groupId, memberId, createdAt])
  @@index([memberId, attribute, createdAt])
  @@index([proposalId])
}
