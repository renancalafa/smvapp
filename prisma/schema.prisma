  PLAYER
}

enum PlayerModality {
  MONTHLY
  DAILY
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum GameSessionStatus {
  SCHEDULED
  OPEN
  LOCKED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum GameSessionType {
